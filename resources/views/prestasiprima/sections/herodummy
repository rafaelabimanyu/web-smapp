<!-- ================= SCRIPT ================= -->
<script>
(() => {
  const initHeroVideo = () => {
    const videoSection = document.getElementById("heroVideoSection");
    const video = document.getElementById("heroVideo");
    const skipBtn = document.getElementById("skipBtn");
    const skipBtnContainer = document.getElementById("skipBtnContainer");
    const contentSection = document.getElementById("heroContentSection");

    if (!videoSection || !video || !skipBtn || !skipBtnContainer || !contentSection) return;

    const toggleBtn = document.getElementById("toggleSocial");
    const panel = document.getElementById("socialPanel");

    // ===================== Hero Background Slideshow =====================
    const heroImages = [
  "{{ asset('assets/prestasiprima/fotbarguru2.jpg') }}",
  "{{ asset('assets/prestasiprima/gedungsiswa.jpg') }}",
  "{{ asset('assets/images/DSC00015.JPG') }}",
  "{{ asset('assets/images/kurikulum/hero.png') }}",
  "{{ asset('assets/prestasiprima/gedungzoom.jpg') }}",
  "{{ asset('assets/prestasiprima/dance.jpg') }}",
  "{{ asset('assets/prestasiprima/DSC00052.JPG') }}"
];

let currentIndex = 0;
let slideshowInterval = null;

const wrapper = contentSection.querySelector(".hero-slide-wrapper");
const mainImg = wrapper.querySelector("img");

const showNextImage = () => {
  const nextIndex = (currentIndex + 1) % heroImages.length;
  
  // preload gambar
  const nextImg = new Image();
  nextImg.src = heroImages[nextIndex];
  nextImg.onload = () => {
    // style untuk animasi
    nextImg.style.position = "absolute";
    nextImg.style.top = 0;
    nextImg.style.left = 0;
    nextImg.style.width = "100%";
    nextImg.style.height = "100%";
    nextImg.style.objectFit = "cover";
    nextImg.style.transform = "translateX(100%)";
    nextImg.style.transition = "transform 0.8s ease";

    wrapper.appendChild(nextImg);

    // trigger animasi di next frame
    requestAnimationFrame(() => {
      nextImg.style.transform = "translateX(0)";
      mainImg.style.transform = "translateX(-100%)";
    });

    setTimeout(() => {
      mainImg.src = nextImg.src;   // update mainImg
      mainImg.style.transition = "none";
      mainImg.style.transform = "translateX(0)";
      wrapper.removeChild(nextImg); // hapus elemen temp
      currentIndex = nextIndex;
    }, 850);
  };
};

const startSlideshow = () => {
  if (slideshowInterval) clearInterval(slideshowInterval);
  slideshowInterval = setInterval(showNextImage, 5000);
};

    const stopSlideshow = () => {
      if (slideshowInterval) clearInterval(slideshowInterval);
      slideshowInterval = null;
    };

    // ===================== Hero Video =====================
    const resetState = () => {
      videoSection.style.display = "";
      videoSection.style.opacity = "";
      skipBtnContainer.style.display = "";
      contentSection.classList.add("hidden");
      contentSection.classList.remove("flex");
      contentSection.style.opacity = 0;
      stopSlideshow();
    };

    const ensureVideoVisible = () => {
      video.classList.add("opacity-100");
      video.classList.remove("opacity-0");
      videoSection.style.opacity = 1;
    };

    const showContent = () => {
      if (video.dataset.heroContentShown === "1") return;
      video.dataset.heroContentShown = "1";
      window.clearTimeout(video._heroFallbackTimer);
      videoSection.style.transition = "opacity 0.5s";
      videoSection.style.opacity = 0;

      setTimeout(() => {
        video.pause();
        video.currentTime = 0;
        videoSection.style.display = "none";
        skipBtnContainer.style.display = "none";
        contentSection.classList.remove("hidden");
        contentSection.classList.add("flex");
        contentSection.style.opacity = 1;

        document.querySelectorAll(".hero-animate").forEach((el, idx) => {
          el.style.animationDelay = `${idx * 0.12}s`;
          el.classList.add("animate-hero-fast");
        });

        startSlideshow();
      }, 500);
    };

    const bindUnique = (el, event, handler, key) => {
      if (!el) return;
      const storeKey = `_hero_${key}`;
      if (el[storeKey]) el.removeEventListener(event, el[storeKey]);
      el.addEventListener(event, handler);
      el[storeKey] = handler;
    };

    ["loadeddata", "canplay", "canplaythrough", "playing"].forEach(event =>
      bindUnique(video, event, ensureVideoVisible, `visible_${event}`)
    );
    bindUnique(video, "error", ensureVideoVisible, "visible_error");
    bindUnique(video, "ended", showContent, "ended");
    bindUnique(skipBtn, "click", showContent, "skip");
  };

  const cleanupHeroVideo = () => {
    const video = document.getElementById("heroVideo");
    if (video) {
      video.pause();
      video.currentTime = 0;
      video.classList.remove("opacity-100");
      video.classList.add("opacity-0");
      delete video.dataset.heroContentShown;
      clearTimeout(video._heroFallbackTimer);
    }
  };

  if (document.readyState !== "loading") initHeroVideo();
  else document.addEventListener("DOMContentLoaded", initHeroVideo, { once: true });
})();
</script>

<!-- ================= STYLE ================= -->
<style>
.hero-animate { opacity: 0; }
@keyframes heroSlideInFast {
  0% { opacity: 0; transform: translateX(-80px) scale(0.95); filter: blur(4px); }
  60% { opacity: 1; transform: translateX(10px) scale(1.02); filter: blur(0); }
  80% { transform: translateX(-4px) scale(0.98); }
  100% { opacity: 1; transform: translateX(0) scale(1); }
}
.animate-hero-fast { animation: heroSlideInFast 0.9s cubic-bezier(0.25,1,0.5,1) forwards; }

/* Slideshow */
.hero-slide-wrapper { position: absolute; inset:0; width:100%; height:100%; overflow:hidden; z-index:0; }
.hero-slide-wrapper img { position:absolute; top:0; left:0; width:100%; height:100%; object-fit:cover; transition: transform 0.8s ease; }

/* Optional overlay for readability */
.hero-slide-wrapper > div { position:absolute; inset:0; background:rgba(0,0,0,0.5); z-index:1; }
</style>
